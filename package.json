{
  "name": "sprout-trail",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Sprout Trail - a cozy 2.5D forest platformer with plant-choice puzzles, playable with one finger",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "build:gd": "tsc --noEmit && vite build --mode gd",
    "build:gamepix": "tsc --noEmit && vite build --mode gamepix",
    "build:playgama": "tsc --noEmit && vite build --mode playgama",
    "build:all": "npm run build && npm run build:web && npm run build:gd && npm run build:gamepix && npm run build:playgama",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "assets": "node scripts/assets.mjs",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "playtest": "tsx scripts/playtest.ts",
    "playtest:browser": "tsx scripts/playtest-browser.ts",
    "playtest:report": "tsx scripts/playtest-report.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:gd": "node scripts/check-gd.mjs dist-gd",
    "check:size": "node scripts/check-size.mjs dist && node scripts/check-size.mjs dist-web && node scripts/check-size.mjs dist-gd && node scripts/check-size.mjs dist-gamepix && node scripts/check-size.mjs dist-playgama",
    "submission": "node scripts/submission/build.mjs",
    "submission:check": "node scripts/submission/check.mjs",
    "submission:web": "npm run build:web && node scripts/web/zip.mjs",
    "check:web": "node scripts/web/check.mjs",
    "store:web": "node scripts/web/store.mjs",
    "submission:playgama": "npm run build:playgama && node scripts/playgama/zip.mjs",
    "check:playgama": "node scripts/playgama/check.mjs",
    "test:playgama": "node scripts/playgama/test.mjs",
    "covers": "tsx scripts/submission/covers.ts",
    "trailer": "tsx scripts/submission/trailer.ts",
    "preview:shots": "tsx scripts/preview-shots.ts",
    "preview:video": "tsx scripts/preview-video.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.170.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
